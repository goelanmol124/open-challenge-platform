# Copy to .env.local (or .env) and fill in. Never commit the real file.
# All values below are placeholders.

# ─── Platform preset ──────────────────────────────────────────────────────────
# Which configuration to use. "custom" (default) = whatever platform.config.ts
# exports. Or pick a bundled example: civic | corporate | research
# NEXT_PUBLIC_ because the labels are needed in the browser too; it is read
# at build time, so rebuild after changing it.
NEXT_PUBLIC_PLATFORM_PRESET=custom

# ─── App ──────────────────────────────────────────────────────────────────────
# Public URL of the deployment (no trailing slash). Used for metadata/links.
APP_URL=http://localhost:3000

# ─── Database (MySQL 8) ───────────────────────────────────────────────────────
# docker compose up -d gives you exactly this:
DATABASE_URL=mysql://app:app@localhost:3306/challenges

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign session cookies (HS256 JWT). At least 32 characters.
# Generate with:  openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# Optional: bootstrap an admin on first run of `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please

# ─── Background evaluation ────────────────────────────────────────────────────
# Bearer token for GET /api/cron/evaluate (retries pending/failed evaluations).
# Generate with:  openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# ─── AI provider ──────────────────────────────────────────────────────────────
# gemini (default) | openai-compatible | mock
# "mock" needs no key: deterministic fake scores, good for local development.
AI_PROVIDER=mock

# Gemini (Google AI Studio key) ...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ... or Gemini via Vertex AI (set all three; credentials = base64 of a
# service-account JSON, or use GOOGLE_APPLICATION_CREDENTIALS instead).
GEMINI_USE_VERTEX_AI=false
GEMINI_VERTEX_PROJECT=
GEMINI_VERTEX_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS_JSON_B64=

# OpenAI-compatible chat-completions API (OpenAI, OpenRouter, Groq, Together,
# a local Ollama/vLLM server, ...).
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
