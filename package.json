{
  "name": "open-challenge-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Config-driven open innovation / challenge platform template: owners post problems, solvers submit solutions, AI evaluates them against your rubric, owners endorse. Next.js + Drizzle + MySQL.",
  "keywords": [
    "innovation-challenge-platform",
    "open-innovation",
    "hackathon-platform",
    "problem-solution-marketplace",
    "ai-evaluation",
    "nextjs-template",
    "drizzle",
    "mysql",
    "gemini"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "config:check": "tsx scripts/check-config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "eval:pending": "tsx scripts/evaluate-pending.ts"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.575.0",
    "mysql2": "^3.20.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
